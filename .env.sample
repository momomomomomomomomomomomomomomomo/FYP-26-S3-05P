PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=storynest
# Set to true against managed MySQL (Appwrite, RDS, PlanetScale), which only
# accepts TLS. Leave it out for a local MySQL, which usually has no certificate.
DB_SSL=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d