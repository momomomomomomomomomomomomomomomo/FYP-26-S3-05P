# --- Server ---
PORT=3000
NODE_ENV=development

# --- MySQL (local) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=change_to_custom_value
DB_PASSWORD=change_to_custom_value
DB_NAME=change_to_custom_value

# --- Auth ---
# Change this to a long random string before running anywhere but your laptop.
JWT_SECRET=change_to_custom_value
JWT_EXPIRES_IN=7d
